# Copiar a .env y rellenar solo si la terminal de MT5 no tiene ya la sesión iniciada.
# .env no se versiona.
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Cuenta de Exness para demo_exness_bot.py, panel_control.py y train_exness.py (ver cuenta.py).
# Todo vacío = la demo original. La terminal debe tener ya la sesión iniciada: aquí no va ninguna contraseña.
EXNESS_LOGIN=
EXNESS_SERVER=
EXNESS_TERMINAL=
# 1 si la cuenta es real. Sin él, una cuenta real detiene el bot.
EXNESS_CUENTA_REAL=
# Por defecto 1 en real y 0 en demo: con 1 el bot no arranca si el modelo no tiene ventaja significativa.
EXNESS_EXIGIR_VENTAJA=
